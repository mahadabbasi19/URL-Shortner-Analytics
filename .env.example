# --- PostgreSQL ---
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_DB=url_shortener
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://shortener:change_me_in_dev@postgres:5432/url_shortener

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Short code ---
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_RETRIES=5

# --- Rate limiting (requests per window, window in seconds) ---
RATE_LIMIT_ANON_CREATE=10/3600
RATE_LIMIT_AUTH_CREATE=100/3600
RATE_LIMIT_AUTH_LOGIN=10/300
RATE_LIMIT_REDIRECT=300/60
RATE_LIMIT_ANALYTICS=120/60

# --- Geolocation (optional local MaxMind GeoLite2 database) ---
GEOIP_DATABASE_PATH=./data/GeoLite2-City.mmdb
